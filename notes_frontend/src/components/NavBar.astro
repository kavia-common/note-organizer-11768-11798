---
/**
 * Top navigation bar with brand, search, and add button slot for actions.
 * Props:
 *  - onAddId: id of button for JS to hook into (string)
 *  - searchId: id of search input (string)
 *  - initialQuery: initial search text
 */
const { onAddId = 'add-note-btn', searchId = 'search-notes', initialQuery = '' } = Astro.props;
---
<header class="topbar">
  <div class="topbar-inner container">
    <div class="brand" aria-label="Notes">
      <div class="brand-badge" title="Notes">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 3h9l5 5v13a1 1 0 0 1-1 1H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" stroke="white" stroke-width="2"/>
          <path d="M14 3v4a1 1 0 0 0 1 1h4" stroke="white" stroke-width="2"/>
        </svg>
      </div>
      <span>Note Organizer</span>
    </div>

    <input id={searchId} class="search" type="search" placeholder="Search notes..." value={initialQuery} aria-label="Search notes" />

    <div class="nav-actions">
      <button id={onAddId} class="btn btn-accent" title="Create note">New Note</button>
    </div>
  </div>
</header>

<script>
  // No-op island; other components can attach events by ids
</script>
